# Environment variables for the assessment platform (see docs/ASSESSMENTS.md).
# Copy the lines you need into .env.local (local) and your hosting provider's
# environment settings (production). Never prefix these with NEXT_PUBLIC_.

# --- Storage (Firestore via the Firebase Admin SDK) -------------------------------
# Option A: the whole service-account JSON (raw JSON or base64 of it).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields (keep the \n escapes in the private key).
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_ADMIN_PROJECT_ID=   # defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID

# --- Thumbnail uploads (Firebase Storage, through the credentials above) ------------
# Defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET, which is already set for the site.
# FIREBASE_STORAGE_BUCKET=

# --- Who may manage assessments ----------------------------------------------------
# Comma-separated Firebase account emails. If empty, any signed-in Firebase user is an admin.
ASSESSMENT_ADMIN_EMAILS=

# --- Email (SMTP) -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chaitanya Raj <no-reply@example.com>"
# MAIL_REPLY_TO=contactchaitanyaraj@gmail.com

# --- Links in emails ----------------------------------------------------------------
# ASSESSMENT_PUBLIC_BASE_URL=https://www.chaitanyaraj.com

# --- Local development only (ignored in production) ---------------------------------
# ASSESSMENT_STORE=file                # force the local JSON file store
# ASSESSMENT_DISABLE_RATE_LIMIT=1      # for automated local test runs
